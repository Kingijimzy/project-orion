NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ALLOW_PAID_MODEL=false
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_ALLOW_PAID_MODEL=false

# Optional personal-use forex intraday candles (Twelve Data Basic plan)
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# LiveKit voice (server-side only; never expose LIVEKIT_API_SECRET to the browser)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=orion-voice-agent
